# Add these as encrypted runtime variables on the hosting platform.
APP_ENV=production
SERVE_FRONTEND=true

# Prefer the managed provider's connection URL:
MYSQL_URL=mysql://user:percent_encoded_password@host:3306/database

# Or leave MYSQL_URL empty and use individual connection values:
MYSQL_HOST=your-managed-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=mysql_ai_lab
MYSQL_USER=mysql_ai_assistant
MYSQL_PASSWORD=replace_with_a_strong_app_password
MYSQL_SSL_DISABLED=false
MYSQL_SSL_VERIFY_CERT=false
MYSQL_SSL_VERIFY_IDENTITY=false

# Most general-purpose hosting platforms do not provide a GPU. Use OpenRouter there.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace_with_your_api_key
OPENROUTER_MODEL=cohere/north-mini-code:free

# On a GPU platform, change AI_PROVIDER to ollama and point this at the private
# Ollama service. Never expose an unauthenticated Ollama endpoint publicly.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=-1
OLLAMA_KEEP_ALIVE=10m

# Do not set PORT when the platform supplies it automatically.
CORS_ORIGINS=https://your-public-domain.example
