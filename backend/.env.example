# Copy this file to .env and replace placeholders locally. Never commit .env.
APP_ENV=development
SERVE_FRONTEND=false

# Local provider (default). No API key is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional bearer token for a private remote Ollama gateway.
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
OLLAMA_HEALTH_TIMEOUT=3
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
# -1 asks Ollama to offload every layer that fits on the GPU.
OLLAMA_NUM_GPU=-1
OLLAMA_TEMPERATURE=0.1

# Optional remote fallback: set AI_PROVIDER=openrouter to use these.
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=cohere/north-mini-code:free

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mysql_ai_lab
MYSQL_USER=mysql_ai_assistant
MYSQL_PASSWORD=your_mysql_password
# Hosted providers can supply one URL instead of the five values above.
# MYSQL_URL=mysql://user:password@host:3306/database
MYSQL_SSL_DISABLED=false
# MYSQL_SSL_CA=/path/to/provider-ca.pem
MYSQL_SSL_VERIFY_CERT=false
MYSQL_SSL_VERIFY_IDENTITY=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_RESULT_ROWS=1000
PENDING_PLAN_EXPIRY_MINUTES=10
