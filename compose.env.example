# Local Docker Compose configuration. Copy to .env and replace both passwords.
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_DATABASE=mysql_ai_lab
MYSQL_USER=mysql_ai_assistant
MYSQL_PASSWORD=replace_with_a_strong_app_password

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=-1
OLLAMA_KEEP_ALIVE=10m

OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free

APP_PORT=8000
CORS_ORIGINS=http://localhost:8000
